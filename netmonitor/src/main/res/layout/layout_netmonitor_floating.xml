<?xml version="1.0" encoding="utf-8"?>
<!--
  NetMonitor floating card.
  Structure: fixed title row + NestedScrollView for the rest.
  Each layer's sub-list sits directly below its summary row.
  RecyclerViews use wrap_content + nestedScrollingEnabled=false so they
  expand in-place inside the scroll container.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/netmonitor_floating_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- ── Title row (always visible, not scrolled) ─────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/netmonitor_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/netmonitor_status_bg"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp"
            android:text="@string/netmonitor_status_unknown"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />
    </LinearLayout>

    <!-- ── Scrollable body ──────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_hint_layers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/netmonitor_hint_layers"
                android:textColor="#99FFFFFF"
                android:textSize="17sp" />

            <!-- ═══ Layer A ═══════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/tv_layer_a_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.08"
                android:text="@string/netmonitor_layer_a_heading"
                android:textAllCaps="true"
                android:textColor="#BBBBBB"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_layer_a_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/netmonitor_total_traffic_default"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:background="#22FFFFFF" />

            <!-- ═══ Layer B ═══════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/tv_layer_b_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.08"
                android:text="@string/netmonitor_layer_b_heading"
                android:textAllCaps="true"
                android:textColor="#BBBBBB"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_layer_b_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/netmonitor_total_traffic_default"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tv_layer_b_conn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/netmonitor_conn_count_default"
                android:textColor="#CCCCCC"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_api_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/netmonitor_api_count_default"
                android:textColor="#99FFFFFF"
                android:textSize="19sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_domains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:background="#22FFFFFF" />

            <!-- ═══ Layer C (DataCollector) ═══════════════════════════════ -->
            <TextView
                android:id="@+id/tv_layer_cpp_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.08"
                android:text="@string/netmonitor_layer_cpp_heading"
                android:textAllCaps="true"
                android:textColor="#BBBBBB"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_layer_cpp_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/netmonitor_total_traffic_default"
                android:textColor="#A5D6A7"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tv_cpp_api_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/netmonitor_cpp_api_count_default"
                android:textColor="#99FFFFFF"
                android:textSize="19sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_cpp_apis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:background="#22FFFFFF" />

            <!-- ═══ Layer D (Socket) ═══════════════════════════════════════
                 Comprehensive application-side view (libc socket hook —
                 covers Java + C++ HTTP). Cross-validate against Layer A. -->

            <TextView
                android:id="@+id/tv_layer_socket_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.08"
                android:text="@string/netmonitor_layer_socket_heading"
                android:textAllCaps="true"
                android:textColor="#BBBBBB"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_layer_socket_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/netmonitor_total_traffic_default"
                android:textColor="#90CAF9"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tv_layer_socket_conn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/netmonitor_socket_conn_default"
                android:textColor="#CCCCCC"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_layer_socket_hook_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/netmonitor_socket_hook_off"
                android:textColor="#AAAAAA"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_socket_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/netmonitor_socket_list_heading"
                android:textColor="#99FFFFFF"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tv_socket_endpoint_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/netmonitor_socket_endpoint_count_default"
                android:textColor="#77FFFFFF"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_socket_endpoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ── Banner ──────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="#55FFA726"
                android:padding="9dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
